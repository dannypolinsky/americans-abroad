# Frontend API URL - points to the backend server
VITE_API_URL=https://PolinskyNAS.myqnapcloud.com/api

# --- Deployment credentials (used by deploy.sh; not needed to run the app locally) ---
# QNAP NAS (backend). Deploy.sh prefers SSH key auth (~/.ssh/nas_deploy) and
# auto-falls back to the Tailscale IP when the local IP is unreachable.
# QNAP_SSH_HOST=192.168.4.61
# QNAP_SSH_USER=admin
# QNAP_REMOTE_PATH=/share/Container/americans-abroad

# IONOS (frontend static hosting)
# IONOS_SSH_HOST=
# IONOS_SSH_USER=
# IONOS_SSH_PASS=
# IONOS_REMOTE_PATH=
